# genai service
PORT=8000
# Shared API key required on POST /v1/workflow/run (must match the backend's GENAI_API_KEY)
GENAI_API_KEY=change-me

# LiteLLM (OpenAI-compatible gateway) — same proxy the TypeScript backend uses
LITELLM_BASE_URL=https://litellm.lowjungxuan.dpdns.org/v1
LITELLM_API_KEY=

# Langfuse (prompt management + tracing) — same project the backend uses
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_LABEL=production
LANGFUSE_TRACING_ENABLED=true
TOOL_REASONING_PROMPT_NAME=tool-reasoning

# Prompt provider. Keep `langfuse` for the existing production prompts; switch to
# `langsmith` only after the same prompt names exist in LangSmith.
PROMPT_PROVIDER=langfuse

# LangSmith (optional tracing, prompt pull, feedback, and offline evals).
# Leave disabled until LANGSMITH_API_KEY is provided.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=aireye-genai
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING_ENABLED=true
LANGSMITH_PROMPT_TAG=production
LANGSMITH_FEEDBACK_ENABLED=true
LANGSMITH_DATASET_NAME=aireye-genai-regression

# Vision image preprocessing. Remote image URLs are downloaded by GenAI, resized,
# compressed, and sent to the model as a JPEG data URL to avoid provider-side URL
# download timeouts.
VISION_IMAGE_INLINE_ENABLED=true
VISION_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
VISION_IMAGE_MAX_DOWNLOAD_BYTES=15000000
VISION_IMAGE_MAX_LONG_EDGE=2000
VISION_IMAGE_JPEG_QUALITY=82
# Confidentiality guardrail: keep image bytes/URLs out of Langfuse/LangSmith.
VISION_TRACE_IMAGE_INPUTS=false

# RAG (LlamaIndex + Qdrant). Embeddings are routed through LiteLLM using a FIXED
# model so the vector space stays stable when the vision/reasoning provider is switched.
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aireye_templates
GENAI_EMBED_MODEL=text-embedding-3-small
RAG_TOP_K=3
