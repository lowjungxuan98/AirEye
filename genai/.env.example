# genai service
PORT=8000
# Shared API key required on POST /v1/workflow/run (must match the backend's GENAI_API_KEY)
GENAI_API_KEY=change-me

# LiteLLM (OpenAI-compatible gateway) — same proxy the TypeScript backend uses
LITELLM_BASE_URL=https://litellm.lowjungxuan.dpdns.org/v1
LITELLM_API_KEY=

# Langfuse (prompt management + tracing) — same project the backend uses
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_LABEL=production
LANGFUSE_TRACING_ENABLED=true
TOOL_REASONING_PROMPT_NAME=tool-reasoning

# RAG (LlamaIndex + Qdrant). Embeddings are routed through LiteLLM using a FIXED
# model so the vector space stays stable when the vision/reasoning provider is switched.
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aireye_templates
GENAI_EMBED_MODEL=text-embedding-3-small
RAG_TOP_K=3
